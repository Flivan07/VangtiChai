<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NoteText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/padding_default</item>
        <item name="android:textSize">@dimen/text_size_note</item>
    </style>

    <style name="KeyButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">@dimen/key_margin</item>
        <item name="android:textSize">@dimen/text_size_button</item>
    </style>
</resources>